{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "server/postgres-worker.js",
          "server/schema-postgres.sql",
          "server/db-sqlite.js"
        ]
      }
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/client/assets/$1"
    },
    {
      "src": "/(favicon\\.svg|icons\\.svg)",
      "dest": "/client/$1"
    },
    {
      "src": "/logo-smpn11-ppu\\.jpg",
      "dest": "/client/logo-smpn11-ppu.jpg"
    },
    {
      "src": "/(manifest\\.webmanifest|sw\\.js|offline\\.html|pwa-192\\.png|pwa-512\\.png|pwa-512-maskable\\.png|apple-touch-icon\\.png)",
      "dest": "/client/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/client/index.html"
    }
  ]
}